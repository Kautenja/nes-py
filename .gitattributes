# Keep native code and Python code classified consistently, including tests.
*.cpp linguist-language=C++
*.hpp linguist-language=C++
*.py linguist-language=Python

# Group handwritten Cython bindings with the Python interface in language stats.
*.pyx linguist-language=Python
*.pxd linguist-language=Python
*.pxi linguist-language=Python

# Exclude documentation and citation metadata from language statistics.
*.md linguist-documentation
docs/** linguist-documentation
/CITATION.bib linguist-documentation
/CITATION.cff linguist-documentation

# Exclude build tooling, dependency metadata, and GitHub configuration.
/.github/** -linguist-detectable
/CMakeLists.txt -linguist-detectable
/main.sh -linguist-detectable
/pyproject.toml -linguist-detectable
/requirements.txt -linguist-detectable

# Exclude ROM fixtures while retaining the surrounding Python test code.
/nes_py/tests/games/** -linguist-detectable
